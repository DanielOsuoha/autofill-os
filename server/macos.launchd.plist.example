<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.autofillos.oauth</string>
  <key>ProgramArguments</key><array>
    <string>ABSOLUTE_NODE_PATH</string>
    <string>--env-file=server/.env</string>
    <string>server/index.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>ABSOLUTE_REPOSITORY_PATH</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
</dict></plist>
