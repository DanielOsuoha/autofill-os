{
  "manifest_version": 3,
  "name": "Autofill OS Identity Test",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://gmail.googleapis.com/*"
  ],
  "action": {
    "default_title": "Open identity experiment"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "oauth2": {
    "client_id": "624270408645-jie4nfo3oq1hl7ll8a52g5bg7f6nqq10.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.profile",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  }
}
