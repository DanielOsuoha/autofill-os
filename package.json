{
  "name": "autofill-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "oauth:server": "node --env-file=server/.env server/index.mjs",
    "test:page": "node scripts/test-page.mjs",
    "test:extension": "npm run build && node scripts/check-content.mjs",
    "test:browser": "npm run build && node scripts/check-browser.mjs",
    "test:broker": "node scripts/check-broker.mjs",
    "test:cloudflare": "node scripts/check-cloudflare.mjs",
    "oauth:cloud:login": "wrangler login",
    "oauth:cloud:check": "wrangler deploy --dry-run --config server/cloudflare/wrangler.jsonc",
    "oauth:cloud:deploy": "wrangler deploy --config server/cloudflare/wrangler.jsonc",
    "oauth:cloud:secrets": "node scripts/cloudflare-secrets.mjs",
    "oauth:cloud:use": "node scripts/use-cloudflare.mjs",
    "test:cloudflare:runtime": "node scripts/check-cloudflare-runtime.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
